{
  "name": "promenade",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "description": "Static-first exhibition guide with a local authoring studio.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently -k -n site,studio,api -c blue,magenta,green \"npm:dev:site\" \"npm:dev:studio\" \"npm:dev:api\"",
    "dev:site": "node scripts/ensure-demo-show.mjs && astro dev --host 0.0.0.0 --port 4321",
    "dev:studio": "node scripts/ensure-demo-show.mjs && vite --host 0.0.0.0 --port 4173 --config studio/vite.config.ts",
    "dev:api": "node scripts/ensure-demo-show.mjs && tsx watch studio/server/index.ts",
    "build": "node scripts/ensure-demo-show.mjs && astro build && node scripts/prune-public-build.mjs && node scripts/postbuild-sw.mjs",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "check": "astro check && tsc --noEmit",
    "lint": "biome check --diagnostic-level=error astro.config.mjs biome.json lib scripts studio tests playwright.config.ts vitest.config.ts tsconfig.json package.json",
    "format": "biome format --write .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node scripts/ensure-demo-show.mjs && vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed:demo": "node scripts/seed-demo-show.mjs",
    "show:backup": "tsx scripts/show-backup.ts",
    "show:import": "tsx scripts/show-import.ts",
    "show:activate": "tsx scripts/show-activate.ts",
    "bundle:public": "tsx scripts/bundle-public-deploy.ts",
    "build:studio": "vite build --config studio/vite.config.ts",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "astro": "^6.0.5",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "js-yaml": "^4.1.0",
    "multer": "^2.0.2",
    "openai": "^6.6.0",
    "pdf-lib": "^1.17.1",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@biomejs/biome": "^2.2.4",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "workbox-build": "^7.3.0"
  }
}
