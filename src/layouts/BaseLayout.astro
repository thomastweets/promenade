---
import Analytics from "../components/Analytics.astro"
import "../styles/global.css"
import { getAlternateLocales, localize } from "@lib/i18n"
import { buildLocalePath, swapLocaleInPath } from "@lib/routing"
import {
  getShowPublicLocales,
  localeMeta,
  type Locale,
  type Show
} from "@lib/schema"
import { ThemeToggle } from "@lib/ThemeToggle"
import { chromeCopy } from "@lib/ui"

type Props = {
  title: string
  description: string
  locale: Locale
  show: Show
  currentPath: string
  compactMobileHeader?: boolean
  hideFooterOnMobile?: boolean
}

const {
  title,
  description,
  locale,
  show,
  currentPath,
  compactMobileHeader = false,
  hideFooterOnMobile = false
} = Astro.props as Props
const copy = chromeCopy[locale]
const publicLocales = getShowPublicLocales(show)
const alternateLocales = getAlternateLocales(locale, show)
const localeLinks = publicLocales.map((targetLocale) => ({
  locale: targetLocale,
  href: swapLocaleInPath(currentPath, targetLocale)
}))
const logoSrc = show.branding.logoSrc
const iconType = logoSrc.endsWith(".svg")
  ? "image/svg+xml"
  : logoSrc.endsWith(".png")
    ? "image/png"
    : logoSrc.endsWith(".webp")
      ? "image/webp"
      : logoSrc.endsWith(".jpg") || logoSrc.endsWith(".jpeg")
        ? "image/jpeg"
        : undefined
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta content={description} name="description" />
    <meta content={Astro.generator} name="generator" />
    <meta content={show.title[locale]} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content="website" property="og:type" />
    <meta content={logoSrc} property="og:image" />
    <meta content={show.branding.accent} name="theme-color" />
    <link href={logoSrc} rel="icon" type={iconType} />
    <link href={logoSrc} rel="apple-touch-icon" />
    <link href="/site.webmanifest" rel="manifest" />
    {localeLinks.map((item) => (
      <link href={item.href} hreflang={item.locale} rel="alternate" />
    ))}
    <title>{title}</title>
    <script is:inline>
      (() => {
        const key = "promenade-theme";
        const stored = window.localStorage.getItem(key);
        const preference =
          stored === "light" || stored === "dark" || stored === "system"
            ? stored
            : "system";
        const resolved =
          preference === "system"
            ? window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : preference;
        const root = document.documentElement;
        root.dataset.themePreference = preference;
        root.dataset.theme = resolved;
        root.style.colorScheme = resolved;
        root.classList.toggle("dark", resolved === "dark");
      })();
    </script>
  </head>
  <body
    style={`--brand-accent:${show.branding.accent};--brand-accent-soft:${show.branding.accentSoft};--brand-paper:${show.branding.paper};--brand-ink:${show.branding.ink};`}
  >
    <div class="min-h-screen">
      <header class="no-print sticky top-0 z-40 border-b border-white/70 bg-white/70 backdrop-blur-xl dark:border-white/10 dark:bg-slate-950/72">
        <div
          class:list={[
            "mx-auto flex max-w-7xl items-center justify-between px-4 md:hidden",
            compactMobileHeader ? "gap-3 py-2.5" : "gap-4 py-3"
          ]}
        >
          <a class="flex min-w-0 items-center gap-3" href={buildLocalePath(locale)}>
            <img
              alt={show.organization.name}
              class:list={[
                "rounded-2xl object-cover shadow-lg",
                compactMobileHeader ? "h-9 w-9" : "h-10 w-10"
              ]}
              src={show.branding.logoSrc}
            />
            <div class="min-w-0">
              <p class:list={[
                "display-type truncate text-slate-900 dark:text-white",
                compactMobileHeader ? "text-sm" : "text-base"
              ]}>{localize(locale, show.title)}</p>
              <p class:list={[
                "truncate uppercase text-slate-500 dark:text-slate-400",
                compactMobileHeader
                  ? "text-[9px] tracking-[0.24em]"
                  : "text-[10px] tracking-[0.26em]"
              ]}>
                {show.organization.name}
              </p>
            </div>
          </a>
          <div class="flex shrink-0 items-center gap-2">
            {compactMobileHeader ? null : (
              <>
                <a class="rounded-full border border-slate-200 bg-white/80 px-3 py-2 text-xs font-semibold text-slate-700 dark:border-white/10 dark:bg-slate-900/80 dark:text-slate-200" href={buildLocalePath(locale, "artworks/")}>
                  {copy.artworks}
                </a>
                {alternateLocales.map((targetLocale) => (
                  <a
                    aria-label={`${copy.switchLabel}: ${localeMeta[targetLocale].autonym}`}
                    class="rounded-full border border-[color:var(--brand-accent)] px-3 py-2 text-xs font-semibold text-[color:var(--brand-accent)]"
                    href={swapLocaleInPath(currentPath, targetLocale)}
                  >
                    {localeMeta[targetLocale].autonym}
                  </a>
                ))}
              </>
            )}
            <details class="relative">
              <summary class="menu-summary list-none rounded-full border border-slate-200 bg-white/80 px-3 py-2 text-xs font-semibold text-slate-700 dark:border-white/10 dark:bg-slate-900/80 dark:text-slate-200">
                {copy.menu}
              </summary>
              <div class="surface-card absolute right-0 top-[calc(100%+0.75rem)] z-20 w-[min(18rem,calc(100vw-2rem))] rounded-[1.5rem] border border-white/70 p-4 shadow-xl">
                <div class="grid grid-cols-2 gap-2 text-sm font-medium text-slate-700 dark:text-slate-200">
                  <a class="rounded-2xl bg-white/80 px-3 py-3 text-center dark:bg-slate-900/80" href={buildLocalePath(locale)}>{copy.home}</a>
                  <a class="rounded-2xl bg-white/80 px-3 py-3 text-center dark:bg-slate-900/80" href={buildLocalePath(locale, "artworks/")}>{copy.artworks}</a>
                  <a class="rounded-2xl bg-white/80 px-3 py-3 text-center dark:bg-slate-900/80" href={buildLocalePath(locale, "help/")}>{copy.help}</a>
                  <a class="rounded-2xl bg-white/80 px-3 py-3 text-center dark:bg-slate-900/80" href={buildLocalePath(locale, "about/")}>{copy.about}</a>
                </div>
                {alternateLocales.length ? (
                  <div class="mt-3 grid grid-cols-2 gap-2">
                    {alternateLocales.map((targetLocale) => (
                      <a
                        aria-label={`${copy.switchLabel}: ${localeMeta[targetLocale].autonym}`}
                        class="rounded-2xl border border-[color:var(--brand-accent)] px-3 py-3 text-center text-sm font-semibold text-[color:var(--brand-accent)]"
                        href={swapLocaleInPath(currentPath, targetLocale)}
                      >
                        {localeMeta[targetLocale].autonym}
                      </a>
                    ))}
                  </div>
                ) : null}
                <div class="mt-4 border-t border-slate-200/80 pt-4 dark:border-white/10">
                  <ThemeToggle
                    client:load
                    darkLabel={copy.themeDark}
                    label={copy.themeLabel}
                    lightLabel={copy.themeLight}
                    systemLabel={copy.themeSystem}
                  />
                </div>
              </div>
            </details>
          </div>
        </div>

        <div class="mx-auto hidden max-w-7xl items-center justify-between gap-6 px-4 py-4 md:flex md:px-8">
          <a class="flex items-center gap-4" href={buildLocalePath(locale)}>
            <img
              alt={show.organization.name}
              class="h-12 w-12 rounded-2xl object-cover shadow-lg"
              src={show.branding.logoSrc}
            />
            <div>
              <p class="display-type text-lg text-slate-900 dark:text-white">{localize(locale, show.title)}</p>
              <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">
                {show.organization.name}
              </p>
            </div>
          </a>
          <nav class="flex items-center gap-2 text-sm font-medium text-slate-700 dark:text-slate-200">
            <a class="rounded-full px-4 py-2 hover:bg-white/90 dark:hover:bg-white/8" href={buildLocalePath(locale)}>{copy.home}</a>
            <a class="rounded-full px-4 py-2 hover:bg-white/90 dark:hover:bg-white/8" href={buildLocalePath(locale, "artworks/")}>
              {copy.artworks}
            </a>
            <a class="rounded-full px-4 py-2 hover:bg-white/90 dark:hover:bg-white/8" href={buildLocalePath(locale, "help/")}>
              {copy.help}
            </a>
            <a class="rounded-full px-4 py-2 hover:bg-white/90 dark:hover:bg-white/8" href={buildLocalePath(locale, "about/")}>
              {copy.about}
            </a>
            <ThemeToggle
              client:load
              compact
              darkLabel={copy.themeDark}
              label={copy.themeLabel}
              lightLabel={copy.themeLight}
              systemLabel={copy.themeSystem}
            />
            {alternateLocales.map((targetLocale) => (
              <a
                aria-label={`${copy.switchLabel}: ${localeMeta[targetLocale].autonym}`}
                class="rounded-full border border-[color:var(--brand-accent)] px-4 py-2 text-[color:var(--brand-accent)]"
                href={swapLocaleInPath(currentPath, targetLocale)}
              >
                {localeMeta[targetLocale].autonym}
              </a>
            ))}
          </nav>
        </div>
      </header>

      <main>
        <slot />
      </main>

      <footer class:list={["border-t border-white/70 bg-white/60 dark:border-white/10 dark:bg-slate-950/60", hideFooterOnMobile && "hidden md:block"]}>
        <div class="mx-auto max-w-7xl px-4 py-10 md:px-8">
          <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
            <div class="flex items-center gap-4">
              <img
                alt={show.organization.name}
                class="h-14 w-14 rounded-[1.2rem] object-cover shadow-lg"
                src={show.branding.logoSrc}
              />
              <div>
                <p class="display-type text-xl text-slate-950 dark:text-white">{localize(locale, show.title)}</p>
                <p class="mt-1 text-xs uppercase tracking-[0.28em] text-slate-500 dark:text-slate-400">
                  {show.organization.name}
                </p>
              </div>
            </div>
            <nav class="flex flex-wrap gap-3 text-sm font-semibold text-slate-700 dark:text-slate-200">
              <a class="rounded-full bg-white px-4 py-2 dark:bg-slate-900/80" href={buildLocalePath(locale, "artworks/")}>{copy.artworks}</a>
              <a class="rounded-full bg-white px-4 py-2 dark:bg-slate-900/80" href={buildLocalePath(locale, "about/")}>{copy.about}</a>
              <a class="rounded-full bg-white px-4 py-2 dark:bg-slate-900/80" href={buildLocalePath(locale, "help/")}>{copy.help}</a>
              {show.organization.website ? (
                <a class="rounded-full bg-white px-4 py-2 dark:bg-slate-900/80" href={show.organization.website} rel="noreferrer" target="_blank">{copy.visitWebsite}</a>
              ) : null}
            </nav>
          </div>
          <p class="mt-6 max-w-3xl text-sm leading-6 text-slate-600 dark:text-slate-300">
            {localize(locale, show.footer)}
          </p>
        </div>
      </footer>
    </div>

    <Analytics domain={show.analytics.domain} provider={show.analytics.provider} />

    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          const isLocalhost = ["localhost", "127.0.0.1", "::1"].includes(
            window.location.hostname
          );
          const cleanupKey = "promenade-sw-cleanup";

          if (isLocalhost) {
            Promise.all([
              navigator.serviceWorker
                .getRegistrations()
                .catch(() => []),
              "caches" in window ? caches.keys().catch(() => []) : Promise.resolve([])
            ])
              .then(async ([registrations, cacheKeys]) => {
                await Promise.all(
                  registrations.map((registration) =>
                    registration.unregister().catch(() => false)
                  )
                );
                await Promise.all(
                  cacheKeys
                    .filter((cacheKey) =>
                      ["promenade-", "pages-", "show-media-", "workbox-precache"]
                        .some((prefix) => cacheKey.startsWith(prefix))
                    )
                    .map((cacheKey) => caches.delete(cacheKey).catch(() => false))
                );

                const needsReload =
                  registrations.length > 0 || navigator.serviceWorker.controller;
                const hasReloaded = window.sessionStorage.getItem(cleanupKey) === "1";

                if (needsReload && !hasReloaded) {
                  window.sessionStorage.setItem(cleanupKey, "1");
                  window.location.reload();
                  return;
                }

                window.sessionStorage.removeItem(cleanupKey);
              })
              .catch(() => undefined);

            return;
          }

          let reloading = false;
          navigator.serviceWorker.addEventListener("controllerchange", () => {
            if (reloading) return;
            reloading = true;
            window.location.reload();
          });
          navigator.serviceWorker
            .register("/sw.js", { updateViaCache: "none" })
            .then((registration) => {
              const requestUpdate = () =>
                registration.update().catch(() => undefined);
              requestUpdate();
              document.addEventListener("visibilitychange", () => {
                if (document.visibilityState === "visible") {
                  requestUpdate();
                }
              });
            })
            .catch(() => undefined);
        });
      }
    </script>
  </body>
</html>
