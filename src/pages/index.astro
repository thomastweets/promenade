---
import { getServerEnv } from "@lib/env.server"

const fallbackLocale = getServerEnv().DEFAULT_LOCALE
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>Promenade</title>
  </head>
  <body>
    <script define:vars={{ fallbackLocale }} is:inline>
      const stored = window.localStorage.getItem("promenade-locale");
      const languages = navigator.languages ?? [navigator.language];
      const supported = ["de", "en"];
      const normalize = (value) => {
        if (!value) return null;
        const short = value.toLowerCase().split("-")[0];
        return supported.includes(short) ? short : null;
      };
      const locale =
        normalize(stored) ||
        languages.map(normalize).find(Boolean) ||
        fallbackLocale;
      window.location.replace(`/${locale}/`);
    </script>
    <p>
      Redirecting. If this does not happen automatically, continue to
      <a href={`/${fallbackLocale}/`}>the exhibition</a>.
    </p>
  </body>
</html>

