---
import { loadShowBundleSync } from "@lib/content"
import { buildGuideStationLookup } from "@lib/guide-stations"
import { localize } from "@lib/i18n"
import { buildLocalePath } from "@lib/routing"
import { getShowPublicLocales, isGuidedArtwork, type Locale } from "@lib/schema"
import { homeCopy } from "@lib/ui"
import ArtworkCard from "@web/components/ArtworkCard.astro"
import { EntryPanel } from "@web/components/EntryPanel"
import BaseLayout from "@web/layouts/BaseLayout.astro"

export function getStaticPaths() {
  const bundle = loadShowBundleSync()
  return getShowPublicLocales(bundle.show).map((locale) => ({
    params: { locale }
  }))
}

const locale = Astro.params.locale as Locale
const bundle = loadShowBundleSync()
const guideArtworks = bundle.artworks.filter(isGuidedArtwork)
const guideStations = buildGuideStationLookup(bundle.artworks)
const publicLocales = getShowPublicLocales(bundle.show)
const copy = homeCopy[locale]
const highlights = guideArtworks.slice(0, 3)
const artistCount = new Set(
  guideArtworks.map((artwork) => artwork.artist.trim()).filter(Boolean)
).size
---

<BaseLayout
  currentPath={Astro.url.pathname}
  description={localize(locale, bundle.show.subtitle)}
  locale={locale}
  show={bundle.show}
  title={`${localize(locale, bundle.show.title)} · ${bundle.show.organization.name}`}
>
  <section class="hero-grid border-b border-white/50 dark:border-white/10">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 md:grid-cols-[1.12fr_0.88fr] md:px-8 md:py-20">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.4em] text-[color:var(--brand-accent)]">
          {copy.kicker}
        </p>
        <h1 class="display-type mt-5 max-w-4xl text-5xl leading-tight text-slate-950 dark:text-white md:text-7xl">
          {localize(locale, bundle.show.title)}
        </h1>
        <p class="mt-4 max-w-3xl text-xl text-slate-600 dark:text-slate-300">
          {localize(locale, bundle.show.subtitle)}
        </p>
        <p class="mt-6 max-w-2xl text-base leading-7 text-slate-700 dark:text-slate-300">
          {copy.lead}
        </p>
        <div class="mt-8 grid max-w-2xl grid-cols-3 gap-4">
          <div class="surface-card rounded-[1.5rem] p-4">
            <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">{copy.statsArtworks}</p>
            <p class="mt-2 text-3xl font-semibold text-slate-900 dark:text-white">{guideArtworks.length}</p>
          </div>
          <div class="surface-card rounded-[1.5rem] p-4">
            <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">{copy.statsArtists}</p>
            <p class="mt-2 text-3xl font-semibold text-slate-900 dark:text-white">{artistCount}</p>
          </div>
          <div class="surface-card rounded-[1.5rem] p-4">
            <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">{copy.statsLocales}</p>
            <p class="mt-2 text-3xl font-semibold text-slate-900 dark:text-white">{publicLocales.length}</p>
          </div>
        </div>
      </div>

      <div class="space-y-6">
        <EntryPanel client:load locale={locale} showId={bundle.show.id} />
        <div class="surface-card rounded-[2rem] p-6">
          <p class="text-sm leading-7 text-slate-700 dark:text-slate-300">{localize(locale, bundle.show.intro)}</p>
          <a
            class="mt-5 inline-flex rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white dark:bg-white dark:text-slate-950"
            href={buildLocalePath(locale, "artworks/")}
          >
            {copy.browseButton}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 md:px-8">
    <div class="mb-8 flex items-end justify-between gap-6">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.35em] text-[color:var(--brand-accent)]">
          {copy.highlightsEyebrow}
        </p>
        <h2 class="display-type mt-3 text-4xl text-slate-950 dark:text-white">{copy.highlightsHeading}</h2>
      </div>
      <a class="text-sm font-semibold text-[color:var(--brand-accent)]" href={buildLocalePath(locale, "artworks/")}>
        {copy.browseButton}
      </a>
    </div>
    {highlights.length ? (
      <div class="grid gap-6 md:grid-cols-3">
        {highlights.map((artwork) => (
          <ArtworkCard
            artwork={artwork}
            locale={locale}
            stationId={guideStations.get(artwork.id)?.stationId ?? artwork.id}
          />
        ))}
      </div>
    ) : (
      <div class="surface-card rounded-[1.75rem] p-6 text-sm leading-7 text-slate-600 dark:text-slate-300">
        {locale === "de"
          ? "Die ersten Audioguide-Werke erscheinen hier, sobald sie fuer Besucherinnen und Besucher freigeschaltet sind."
          : locale === "es"
            ? "Las primeras obras de la audioguía aparecerán aquí en cuanto se publiquen para las y los visitantes."
            : "Audio-guide works will appear here once they are released for visitors."}
      </div>
    )}
  </section>
</BaseLayout>
