---
import { loadShowBundleSync } from "@lib/content"
import { localize } from "@lib/i18n"
import { buildLocalePath } from "@lib/routing"
import type { Locale } from "@lib/schema"
import { homeCopy } from "@lib/ui"
import ArtworkCard from "@web/components/ArtworkCard.astro"
import { EntryPanel } from "@web/components/EntryPanel"
import BaseLayout from "@web/layouts/BaseLayout.astro"

export function getStaticPaths() {
  return [{ params: { locale: "de" } }, { params: { locale: "en" } }]
}

const locale = Astro.params.locale as Locale
const bundle = loadShowBundleSync()
const copy = homeCopy[locale]
const highlights = bundle.artworks.slice(0, 3)
---

<BaseLayout
  currentPath={Astro.url.pathname}
  description={localize(locale, bundle.show.subtitle)}
  locale={locale}
  show={bundle.show}
  title={`${localize(locale, bundle.show.title)} · Promenade`}
>
  <section class="hero-grid border-b border-white/50 dark:border-white/10">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 md:grid-cols-[1.15fr_0.85fr] md:px-8 md:py-20">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.4em] text-[color:var(--brand-accent)]">
          {copy.kicker}
        </p>
        <h1 class="display-type mt-5 max-w-4xl text-5xl leading-tight text-slate-950 dark:text-white md:text-7xl">
          {localize(locale, bundle.show.title)}
        </h1>
        <p class="mt-4 max-w-3xl text-xl text-slate-600 dark:text-slate-300">
          {localize(locale, bundle.show.subtitle)}
        </p>
        <p class="mt-6 max-w-2xl text-base leading-7 text-slate-700 dark:text-slate-300">
          {copy.lead}
        </p>
        <div class="mt-8 grid max-w-2xl grid-cols-3 gap-4">
          <div class="surface-card rounded-[1.5rem] p-4">
            <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">{copy.statsArtworks}</p>
            <p class="mt-2 text-3xl font-semibold text-slate-900 dark:text-white">{bundle.artworks.length}</p>
          </div>
          <div class="surface-card rounded-[1.5rem] p-4">
            <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">{copy.statsLocales}</p>
            <p class="mt-2 text-3xl font-semibold text-slate-900 dark:text-white">{bundle.show.locales.length}</p>
          </div>
          <div class="surface-card rounded-[1.5rem] p-4">
            <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">{copy.statsMode}</p>
            <p class="mt-2 text-sm font-semibold text-slate-900 dark:text-white">{copy.statsModeValue}</p>
          </div>
        </div>
      </div>

      <div class="space-y-6">
        <EntryPanel client:load locale={locale} showId={bundle.show.id} />
        <div class="surface-card rounded-[2rem] p-6">
          <p class="text-sm leading-7 text-slate-700 dark:text-slate-300">{localize(locale, bundle.show.intro)}</p>
          <a
            class="mt-5 inline-flex rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white dark:bg-white dark:text-slate-950"
            href={buildLocalePath(locale, "artworks/")}
          >
            {copy.browseButton}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 md:px-8">
    <div class="mb-8 flex items-end justify-between gap-6">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.35em] text-[color:var(--brand-accent)]">
          Promenade
        </p>
        <h2 class="display-type mt-3 text-4xl text-slate-950 dark:text-white">{copy.highlightsHeading}</h2>
      </div>
      <a class="text-sm font-semibold text-[color:var(--brand-accent)]" href={buildLocalePath(locale, "artworks/")}>
        {copy.browseButton}
      </a>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {highlights.map((artwork) => <ArtworkCard artwork={artwork} locale={locale} />)}
    </div>
  </section>
</BaseLayout>
