---
import { loadShowBundleSync } from "@lib/content"
import { localize } from "@lib/i18n"
import type { Locale } from "@lib/schema"
import ProseBlock from "@web/components/ProseBlock.astro"
import BaseLayout from "@web/layouts/BaseLayout.astro"

export function getStaticPaths() {
  return [{ params: { locale: "de" } }, { params: { locale: "en" } }]
}

const locale = Astro.params.locale as Locale
const bundle = loadShowBundleSync()
---

<BaseLayout
  currentPath={Astro.url.pathname}
  description={localize(locale, bundle.show.subtitle)}
  locale={locale}
  show={bundle.show}
  title={`${localize(locale, bundle.show.title)} · About`}
>
  <section class="mx-auto grid max-w-7xl gap-10 px-4 py-14 md:grid-cols-[0.85fr_1.15fr] md:px-8">
    <div class="surface-card rounded-[2rem] p-6">
      <img
        alt={bundle.show.organization.name}
        class="h-28 w-28 rounded-[1.6rem] object-cover shadow-lg"
        src={bundle.show.branding.logoSrc}
      />
      <h1 class="display-type mt-6 text-4xl text-slate-950 dark:text-white">{bundle.show.organization.name}</h1>
      <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300">{localize(locale, bundle.show.subtitle)}</p>
      {bundle.show.organization.website ? (
        <a
          class="mt-5 inline-flex text-sm font-semibold text-[color:var(--brand-accent)]"
          href={bundle.show.organization.website}
          rel="noreferrer"
          target="_blank"
        >
          {bundle.show.organization.website}
        </a>
      ) : null}
    </div>

    <div class="space-y-8">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.35em] text-[color:var(--brand-accent)]">
          Promenade
        </p>
        <h2 class="display-type mt-3 text-5xl text-slate-950 dark:text-white">{localize(locale, bundle.show.title)}</h2>
      </div>
      <ProseBlock text={localize(locale, bundle.show.about)} />
    </div>
  </section>
</BaseLayout>
