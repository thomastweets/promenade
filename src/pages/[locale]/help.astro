---
import { loadShowBundleSync } from "@lib/content"
import { localize } from "@lib/i18n"
import { getShowPublicLocales, type Locale } from "@lib/schema"
import { helpLabels } from "@lib/ui"
import BaseLayout from "@web/layouts/BaseLayout.astro"

export function getStaticPaths() {
  const bundle = loadShowBundleSync()
  return getShowPublicLocales(bundle.show).map((locale) => ({
    params: { locale }
  }))
}

const locale = Astro.params.locale as Locale
const bundle = loadShowBundleSync()
const copy = helpLabels[locale]
---

<BaseLayout
  currentPath={Astro.url.pathname}
  description={copy.title}
  locale={locale}
  show={bundle.show}
  title={`${localize(locale, bundle.show.title)} · Help`}
>
  <section class="mx-auto max-w-5xl px-4 py-14 md:px-8">
    <p class="text-sm font-semibold uppercase tracking-[0.35em] text-[color:var(--brand-accent)]">
      Support
    </p>
    <h1 class="display-type mt-4 text-5xl text-slate-950 dark:text-white">{copy.title}</h1>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <article class="surface-card rounded-[2rem] p-6">
        <h2 class="display-type text-2xl text-slate-900 dark:text-white">QR</h2>
        <p class="mt-4 text-sm leading-7 text-slate-700 dark:text-slate-300">{copy.qrs}</p>
      </article>
      <article class="surface-card rounded-[2rem] p-6">
        <h2 class="display-type text-2xl text-slate-900 dark:text-white">Offline</h2>
        <p class="mt-4 text-sm leading-7 text-slate-700 dark:text-slate-300">{copy.offline}</p>
      </article>
      <article class="surface-card rounded-[2rem] p-6">
        <h2 class="display-type text-2xl text-slate-900 dark:text-white">Locale</h2>
        <p class="mt-4 text-sm leading-7 text-slate-700 dark:text-slate-300">{copy.accessibility}</p>
      </article>
    </div>
  </section>
</BaseLayout>
