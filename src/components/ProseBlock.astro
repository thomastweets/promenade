---
const { text, className = "" } = Astro.props as {
  text: string
  className?: string
}

const paragraphs = text
  .split(/\n{2,}/)
  .map((value) => value.trim())
  .filter(Boolean)
---

<div class:list={["space-y-4", className]}>
  {
    paragraphs.map((paragraph) => (
      <p class="text-pretty leading-7 text-slate-700 dark:text-slate-300">{paragraph}</p>
    ))
  }
</div>
